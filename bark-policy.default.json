{
  "_presets": {
    "strict":     "defaultAction: block — everything not explicitly allowed is blocked (recommended)",
    "balanced":   "defaultAction: require_approval — unknown operations need approval, not silently blocked",
    "permissive": "defaultAction: auto_approve — everything allowed unless explicitly blocked (legacy, not recommended)"
  },

  "defaultAction": "block",
  "approvalTimeout": 300000,

  "rules": [
    { "tool": "Read",       "action": "auto_approve" },
    { "tool": "Grep",       "action": "auto_approve" },
    { "tool": "Glob",       "action": "auto_approve" },
    { "tool": "ListDir",    "action": "auto_approve" },
    { "tool": "WebFetch",   "action": "auto_approve" },
    { "tool": "Search",     "action": "auto_approve" },

    { "tool": "Edit",       "action": "require_approval" },
    { "tool": "Write",      "action": "require_approval" },
    { "tool": "MultiEdit",  "action": "require_approval" },

    { "tool": "Bash", "pattern": "^(docker push|kubectl apply|kubectl delete|terraform apply|terraform destroy)", "action": "block" },
    { "tool": "Bash", "pattern": "^(deploy|npm run deploy|yarn deploy|npx deploy)", "action": "require_approval" },
    { "tool": "Bash", "pattern": "^(cat |head |tail |ls |find |grep |rg |wc |echo |pwd|which |type |env$|git status|git log|git diff|git branch|git show|git stash list|yarn |npm test|npm run|npx |node |tsc |vitest|jest)", "action": "auto_approve" },
    { "tool": "Bash", "pattern": "^(git add|git commit|git checkout|git switch|git merge|git rebase|git stash)", "action": "require_approval" },
    { "tool": "Bash", "pattern": "^(git push|git force-push|git reset --hard)", "action": "require_approval" },
    { "tool": "Bash", "pattern": "^(rm -rf|rm -r|rmdir|chmod|chown|sudo)", "action": "require_approval" },
    { "tool": "Bash", "pattern": "^(npm publish|yarn publish|npx publish)", "action": "require_approval" },
    { "tool": "Bash", "pattern": "^(curl.*-X POST|curl.*-X PUT|curl.*-X DELETE|wget)", "action": "require_approval" }
  ],

  "barkignore": [
    ".env", ".env.*",
    "credentials.json", "secrets.json",
    "*.pem", "*.key", "*.p12", "*.pfx",
    ".ssh/*", ".aws/*", ".gcloud/*",
    "**/node_modules/**"
  ]
}
