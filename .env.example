# WhatsApp
WA_ENABLED=true
WA_GROUP=bark-pack

# Telegram (uncomment to enable)
# TELEGRAM_TOKEN=
# TELEGRAM_CHAT_ID=

# Slack (uncomment to enable — requires Socket Mode)
# Bot responds to @mentions in any channel it's in
# SLACK_BOT_TOKEN=xoxb-...
# SLACK_APP_TOKEN=xapp-...

# Owner filter — REQUIRED per platform (no owner = bot ignores all messages)
# Comma-separated for multiple owners, or DANGER-ALL to allow everyone
# WA_OWNER=972501234567,972509876543
# TG_OWNER=123456789
# SLACK_OWNER=U0123456789,U07B2K3LFMN

# Voice transcription (optional) — macOS/Homebrew default shown
# Multilingual model supports Hebrew, English, and 90+ languages (auto-detected)
# Override if your whisper model is in a different location
# WHISPER_MODEL=/opt/homebrew/share/whisper-cpp/models/ggml-base.bin

# LLM Backends — comma-separated list of enabled backends
# Available: claude-code, cursor, codex, gemini
# Requires respective CLI tools to be installed (claude, agent, codex, gemini)
DEFAULT_BACKEND=claude-code
ENABLED_BACKENDS=claude-code,cursor,codex,gemini

# UI Dashboard
# UI_PORT=3333

# API Authentication — protects UI dashboard and API endpoints
# If set, requires login to access. If unset, access is open.
# API_SECRET=your-secret-here

# Agent Fallback — automatic recovery from errors
FALLBACK_ENABLED=true
AGENT_TIMEOUT=600000
FALLBACK_MAX_RETRIES=3
FALLBACK_BACKOFF_MS=5000,15000,30000
FALLBACK_BACKEND_PRIORITY=claude-code,cursor,codex,gemini

# History — server-side conversation tracking for fallback
HISTORY_MAX_TURNS=10
SUMMARY_INTERVAL_TURNS=5
# Max chars stored per turn (prevents huge history files)
# HISTORY_MAX_CONTENT_LEN=2000

# Fallback tuning
# FALLBACK_STRATEGY_ORDER=retry,reset,switch
# FALLBACK_POLL_INTERVAL_MS=2000
# FALLBACK_MAX_CONTEXT_TOKENS=4000

# Security Guard (uses claude CLI — no API key needed)
# SECURITY_GUARD_ENABLED=true
# SECURITY_GUARD_FAIL_OPEN=true
# Max message length forwarded to the security model
# SECURITY_GUARD_MAX_TEXT_LEN=4000
# Claude CLI timeout in ms for security checks
# SECURITY_GUARD_TIMEOUT_MS=30000

# Timeline event buffer
# TIMELINE_MAX_EVENTS=500
# TIMELINE_TRIM_INTERVAL=100
# TIMELINE_MAX_FILE_SIZE=5242880
# TIMELINE_MAX_ROTATED_FILES=3

# Stream display tuning (applied to all backends)
# STREAM_THROTTLE_MS=800
# STREAM_THINKING_PREVIEW_LEN=200

# WhatsApp adapter tuning
# WA_PROTOCOL_TIMEOUT=120000
# WA_PIN_DURATION_SECS=2592000
# WA_MSG_CACHE_MAX=5000

# Telegram adapter tuning
# TG_POLL_TIMEOUT_SECS=30
# TG_POLL_BACKOFF_BASE_MS=5000
# TG_POLL_BACKOFF_MAX_MS=60000
# TG_MAX_MSG_LEN=4096

# Slack adapter tuning
# SLACK_MAX_MSG_LEN=4000

# Status message prefix detection (used to clean up old pinned messages on startup)
# STATUS_MSG_PREFIXES=📋,🐾

# Skills directory (default: .claude/skills, relative to project root)
# SKILLS_DIR=.claude/skills

# Delegation limits
# MAX_DELEGATION_DEPTH=1
# MAX_SUB_AGENTS=3
